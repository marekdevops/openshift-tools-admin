#!/bin/bash
#
# ocp-activate - Wejście do środowiska OpenShift (styl venv)
#
# Użycie: source ocp-activate [-q] [klaster]
#         source ocp-activate            # aktywuj środowisko
#         source ocp-activate prod1      # aktywuj i przełącz na prod1
#         source ocp-activate -q prod1   # bez komunikatu powitalnego
#
# Aktywacja nie loguje do klastrów - logowanie następuje przy pierwszym
# przełączeniu (ocp klaster), jeśli sesja wygasła.
#
# Dezaktywacja: ocp-deactivate [--logout]
#

# Sprawdź czy skrypt jest source'owany
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Ten skrypt musi być uruchomiony przez 'source':"
    echo "  source ocp-activate"
    echo "  source ocp-activate [nazwa-klastra]"
    exit 1
fi

# Ponowna aktywacja nadpisałaby zapamiętany prompt
if [[ -n "$_OCP_ACTIVE" ]]; then
    _ocp_arg="${@: -1}"
    [[ -n "$_ocp_arg" && "$_ocp_arg" != "-q" ]] && ocp "$_ocp_arg"
    unset _ocp_arg
    return 0
fi

_ocp_quiet=0
if [[ "$1" == "-q" ]]; then
    _ocp_quiet=1
    shift
fi

# Zapisz oryginalne wartości do przywrócenia
_OCP_OLD_PS1="${PS1:-}"
_OCP_OLD_PATH="${PATH:-}"
_OCP_OLD_KUBECONFIG="${KUBECONFIG:-}"
_OCP_ACTIVE=1

# ============================================
# ŚCIEŻKI I KONFIGURACJA
# ============================================

export OCP_TOOLS_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export KUBE_CLUSTERS_DIR="${KUBE_CLUSTERS_DIR:-$HOME/.kube/clusters}"
export PATH="$HOME/.local/bin:$OCP_TOOLS_DIR/bin:$PATH"

# Użytkownik LDAP/AD z ~/.config/openshift-tools/config
_ocp_user=$(OCP_USER= bash -c "source '$OCP_TOOLS_DIR/lib/ocp-common.sh' && echo \"\$OCP_USER\"")

if [[ -z "$_ocp_user" ]]; then
    echo -e "\033[1;33mNie skonfigurowano użytkownika LDAP/AD.\033[0m"
    ocp-login --set-user && _ocp_user=$(OCP_USER= bash -c "source '$OCP_TOOLS_DIR/lib/ocp-common.sh' && echo \"\$OCP_USER\"")
fi

# Domyślnie bez klastra - oc nie może przypadkiem użyć ~/.kube/config
unset KUBECONFIG

# ============================================
# ALIASY
# ============================================

alias k='oc'
alias kgp='oc get pods'
alias kgs='oc get services'
alias kgd='oc get deployments'
alias kgn='oc get nodes'
alias kgns='oc get projects'
alias kns='oc project'
alias kl='oc logs'
alias klf='oc logs -f'
alias kexec='oc exec -it'
alias ka='oc apply -f'

# ============================================
# PROMPT Z KONTEKSTEM KUBERNETES
# ============================================

__ocp_prompt() {
    local color_end=$'\001\033[0m\002'

    if [[ -n "$KUBECONFIG" && -f "$KUBECONFIG" ]]; then
        local ctx=$(basename "$KUBECONFIG")
        # Namespace z pliku (lokalnie) - prompt nie odpytuje klastra
        local ns=$(oc config view --minify -o jsonpath='{..namespace}' 2>/dev/null)
        local color_start

        case "$ctx" in
            *prod*)  color_start=$'\001\033[0;31m\002' ;;  # czerwony
            *stag*)  color_start=$'\001\033[0;33m\002' ;;  # żółty
            *dev*)   color_start=$'\001\033[0;32m\002' ;;  # zielony
            *test*)  color_start=$'\001\033[0;34m\002' ;;  # niebieski
            *)       color_start=$'\001\033[0;35m\002' ;;  # fioletowy
        esac

        echo "${color_start}[${ctx}/${ns:-default}]${color_end} "
    else
        echo $'\001\033[0;36m\002'"(ocp)"$'\001\033[0m\002'" "
    fi
}

PS1='$(__ocp_prompt)'"${_OCP_OLD_PS1}"

# ============================================
# FUNKCJE
# ============================================

# Przełącz klaster; loguje tylko, jeśli sesja wygasła
ocp() {
    if [[ -z "$1" ]]; then
        ocp-login --list
        return
    fi

    local name="$1"
    local cluster_file="$KUBE_CLUSTERS_DIR/$name"

    if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || ! -f "$cluster_file" ]]; then
        echo -e "\033[0;31mKlaster '$name' nie istnieje\033[0m"
        echo "Lista: ocp   Dodaj: ocp-add $name https://api.xxx:6443"
        return 1
    fi

    export KUBECONFIG="$cluster_file"
    echo -e "\033[0;32mPrzełączono na: $name\033[0m"

    # Nazwa klastra dla statusline tmux (per okno)
    [[ -n "$TMUX" ]] && tmux set-option -w @ocp_cluster "$name" 2>/dev/null

    ocp-login --ensure "$name"
}

ocp-current() {
    if [[ -z "$KUBECONFIG" ]]; then
        echo -e "\033[0;33mBrak aktywnego klastra. Przełącz: ocp [klaster]\033[0m"
        return 1
    fi
    ocp-login --status "$(basename "$KUBECONFIG")"
}

ocp-check() {
    ocp-login --list
}

ocp-add() {
    ocp-login --add "$@" && ocp "$1"
}

ocp-logout() {
    if [[ -z "$1" && -n "$KUBECONFIG" ]]; then
        ocp-login --logout "$(basename "$KUBECONFIG")"
    else
        ocp-login --logout "$@"
    fi
}

ocp-deactivate() {
    if [[ "$1" == "--logout" ]]; then
        ocp-login --logout --all
    fi

    PS1="$_OCP_OLD_PS1"
    PATH="$_OCP_OLD_PATH"
    if [[ -n "$_OCP_OLD_KUBECONFIG" ]]; then
        export KUBECONFIG="$_OCP_OLD_KUBECONFIG"
    else
        unset KUBECONFIG
    fi
    [[ -n "$TMUX" ]] && tmux set-option -wu @ocp_cluster 2>/dev/null

    unalias k kgp kgs kgd kgn kgns kns kl klf kexec ka 2>/dev/null
    complete -r ocp ocp-login ocp-remove ocp-tmux 2>/dev/null

    unset _OCP_OLD_PS1 _OCP_OLD_PATH _OCP_OLD_KUBECONFIG _OCP_ACTIVE
    unset OCP_TOOLS_DIR KUBE_CLUSTERS_DIR
    unset -f ocp ocp-current ocp-check ocp-add ocp-logout ocp-deactivate \
        __ocp_prompt __ocp_complete_clusters __ocp_complete_remove 2>/dev/null

    echo "Środowisko OCP dezaktywowane"
}

# ============================================
# AUTOUZUPEŁNIANIE
# ============================================

__ocp_complete_clusters() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local clusters=$(ls "$KUBE_CLUSTERS_DIR" 2>/dev/null)
    COMPREPLY=($(compgen -W "$clusters" -- "$cur"))
}

# ocp-remove --restore podpowiada klastry z archiwum
__ocp_complete_remove() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local dir="$KUBE_CLUSTERS_DIR"

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "--restore --delete --list --yes --help" -- "$cur"))
        return
    fi

    [[ " ${COMP_WORDS[*]} " == *" --restore "* || " ${COMP_WORDS[*]} " == *" -r "* ]] && dir="$KUBE_CLUSTERS_DIR/.archive"
    COMPREPLY=($(compgen -W "$(ls "$dir" 2>/dev/null)" -- "$cur"))
}

complete -F __ocp_complete_clusters ocp ocp-login ocp-tmux
complete -F __ocp_complete_remove ocp-remove

if command -v oc &> /dev/null; then
    source <(oc completion bash 2>/dev/null)
fi

# ============================================
# KOMUNIKAT AKTYWACJI
# ============================================

if [[ $_ocp_quiet -eq 0 ]]; then
    echo ""
    echo -e "\033[0;32m✓ Środowisko OpenShift aktywowane\033[0m"
    echo -e "  Użytkownik: \033[0;32m${_ocp_user:-nie ustawiony}\033[0m"
    echo ""
    echo "Komendy:"
    echo "  ocp [klaster]          - przełącz klaster (loguje, gdy sesja wygasła)"
    echo "  ocp                    - lista klastrów ze statusem sesji"
    echo "  ocp-current            - aktualny klaster"
    echo "  ocp-add NAZWA API_URL  - dodaj klaster"
    echo "  ocp-logout [--all]     - wyloguj (unieważnia token)"
    echo "  ocp-remove             - usuń/zarchiwizuj nieużywany klaster"
    echo "  ocp-deactivate         - wyjdź (--logout: wyloguj ze wszystkich)"
    echo ""
fi

unset _ocp_quiet _ocp_user

# Jeśli podano argument, przełącz na klaster
if [[ -n "$1" ]]; then
    ocp "$1"
fi
