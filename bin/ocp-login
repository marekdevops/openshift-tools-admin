#!/bin/bash
#
# ocp-login - Logowanie do klastrów OpenShift własnym użytkownikiem (LDAP/AD)
#
# Każdy klaster to osobny kubeconfig w ~/.kube/clusters/<nazwa>.
# Logowanie: oc login -u $OCP_USER (hasło podaje się bezpośrednio do oc).
#

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/ocp-common.sh" || exit 1

show_help() {
    echo "ocp-login - Logowanie do klastrów OpenShift własnym użytkownikiem"
    echo ""
    echo "Użycie: ocp-login [OPCJE] [klaster]"
    echo ""
    echo "Klastry:"
    echo "  klaster                  Zaloguj się (zawsze, nawet przy ważnej sesji)"
    echo "  --ensure klaster         Zaloguj się tylko, jeśli sesja wygasła"
    echo "  --add klaster API_URL    Dodaj klaster i zaloguj się"
    echo "  -l, --list               Lista klastrów ze statusem sesji"
    echo "  -s, --status klaster     Szczegóły sesji klastra"
    echo "  --logout klaster|--all   Wyloguj (unieważnia token na klastrze)"
    echo ""
    echo "Konfiguracja ($OCP_CONFIG_FILE):"
    echo "  --set-user [login]       Ustaw login LDAP/AD"
    echo "  --set-ca PLIK|none       Plik z firmowym CA (none = systemowy magazyn)"
    echo "  --config                 Pokaż konfigurację"
    echo ""
    echo "  -h, --help               Pokaż tę pomoc"
    echo ""
    echo "Przykłady:"
    echo "  ocp-login --set-user jan.kowalski"
    echo "  ocp-login --add prod-cluster1 https://api.prod1.example.com:6443"
    echo "  ocp-login prod-cluster1"
}

_require_cluster() {
    local name="$1"

    if [[ -z "$name" ]]; then
        echo -e "${RED}Podaj nazwę klastra${NC}"
        return 1
    fi
    if ! ocp_valid_name "$name"; then
        echo -e "${RED}Nieprawidłowa nazwa klastra: '$name'${NC}"
        return 1
    fi
    if [[ ! -f "$(ocp_cluster_file "$name")" ]]; then
        echo -e "${RED}Klaster '$name' nie istnieje${NC}"
        echo "Dodaj: ocp-login --add $name https://api.xxx:6443"
        return 1
    fi
}

_prod_warning() {
    if ocp_is_prod "$1"; then
        echo -e "${RED}⚠️  UWAGA: Środowisko PRODUKCYJNE!${NC}"
    fi
}

# Ochrona: domyślny ~/.kube/config nie powinien zawierać sesji
_protect_default_kubeconfig() {
    local default_config="$HOME/.kube/config"

    if [[ ! -s "$default_config" ]]; then
        mkdir -p "$HOME/.kube"
        cat > "$default_config" <<'BLOCK'
# UWAGA: Ten plik jest celowo pusty!
# Używaj dedykowanych plików kubeconfig z ~/.kube/clusters/ (source ocp-activate)
apiVersion: v1
kind: Config
preferences: {}
clusters: null
contexts: null
users: null
current-context: ""
BLOCK
        chmod 600 "$default_config"
    fi
}

# ============================================
# KONFIGURACJA
# ============================================

set_user() {
    local user="$1"

    if [[ -z "$user" ]]; then
        read -p "Login LDAP/AD [${OCP_USER:-$USER}]: " user
        user="${user:-${OCP_USER:-$USER}}"
    fi

    if [[ ! "$user" =~ ^[A-Za-z0-9._@\\-]+$ ]]; then
        echo -e "${RED}Nieprawidłowy login: '$user'${NC}"
        return 1
    fi

    ocp_save_config OCP_USER "$user"
    echo -e "${GREEN}Użytkownik ustawiony: $user${NC}"
}

set_ca() {
    local ca="$1"

    if [[ -z "$ca" ]]; then
        echo -e "${RED}Podaj plik CA lub 'none'${NC}"
        return 1
    fi

    if [[ "$ca" == "none" ]]; then
        ocp_save_config OCP_CA_FILE ""
        echo -e "${GREEN}Używany będzie systemowy magazyn certyfikatów${NC}"
        return 0
    fi

    ca=$(readlink -f "$ca")
    if [[ ! -f "$ca" ]] || ! grep -q "BEGIN CERTIFICATE" "$ca"; then
        echo -e "${RED}'$ca' nie jest plikiem PEM z certyfikatem${NC}"
        return 1
    fi

    # Zapis jako ~/... - działa po migracji na konto z innym $HOME
    ocp_save_config OCP_CA_FILE "${ca/#$HOME\//\~/}"
    echo -e "${GREEN}CA ustawione: $ca${NC}"
    openssl x509 -in "$ca" -noout -subject -enddate 2>/dev/null | sed 's/^/  /'
}

show_config() {
    echo -e "${BLUE}Konfiguracja:${NC} $OCP_CONFIG_FILE"
    echo "  Użytkownik: ${OCP_USER:-(nie ustawiony)}"
    echo "  CA:         ${OCP_CA_FILE:-systemowy magazyn certyfikatów}"
    echo "  Klastry:    $KUBE_CLUSTERS_DIR"
}

# ============================================
# KLASTRY
# ============================================

add_cluster() {
    local name="$1"
    local server="${2%/}"

    if [[ -z "$name" || -z "$server" ]]; then
        echo -e "${RED}Użycie: ocp-login --add klaster https://api.xxx:6443${NC}"
        return 1
    fi
    if ! ocp_valid_name "$name"; then
        echo -e "${RED}Nieprawidłowa nazwa klastra: '$name'${NC}"
        return 1
    fi
    if [[ "$server" != https://* ]]; then
        echo -e "${RED}API URL musi zaczynać się od https://${NC}"
        return 1
    fi

    local cluster_file
    cluster_file=$(ocp_cluster_file "$name")
    if [[ -f "$cluster_file" ]]; then
        echo -e "${RED}Klaster '$name' już istnieje${NC} ($(ocp_cluster_server "$cluster_file"))"
        echo "Zaloguj się: ocp-login $name   lub usuń: ocp-remove --delete $name"
        return 1
    fi

    # Szkielet kubeconfig (bez sesji) - zapamiętuje API URL klastra
    local kc=(--kubeconfig="$cluster_file")
    oc config set-cluster "$name" --server="$server" "${kc[@]}" >/dev/null &&
        oc config set-context "$name" --cluster="$name" "${kc[@]}" >/dev/null &&
        oc config use-context "$name" "${kc[@]}" >/dev/null || return 1
    chmod 600 "$cluster_file"

    echo -e "${GREEN}Dodano klaster: $name${NC} ($server)"
    echo ""

    ocp_login_cluster "$name" "$server"
}

list_clusters() {
    local names
    names=$(ocp_cluster_names)

    echo -e "${BLUE}Klastry${NC} ${GRAY}(użytkownik: ${OCP_USER:-nie ustawiony})${NC}"

    if [[ -z "$names" ]]; then
        echo "  (brak skonfigurowanych)"
        echo ""
        echo "Dodaj: ocp-login --add klaster https://api.xxx:6443"
        return
    fi

    # Sprawdzenie sesji równolegle - każde zapytanie ma timeout
    local tmpdir name
    tmpdir=$(mktemp -d) || return 1
    for name in $names; do
        ocp_session_status "$(ocp_cluster_file "$name")" > "$tmpdir/$name" &
    done
    wait

    for name in $names; do
        local marker="  "
        [[ "$KUBECONFIG" == "$(ocp_cluster_file "$name")" ]] && marker="${GREEN}*${NC} "
        printf "%b%-24s %b\n" "$marker" "$name" "$(ocp_format_status "$(cat "$tmpdir/$name")")"
    done
    rm -rf "$tmpdir"
}

show_status() {
    local name="$1"
    _require_cluster "$name" || return 1

    local cluster_file
    cluster_file=$(ocp_cluster_file "$name")
    local status
    status=$(ocp_session_status "$cluster_file")

    echo "Klaster:  $name"
    echo "API:      $(ocp_cluster_server "$cluster_file")"
    echo -e "Sesja:    $(ocp_format_status "$status")"
    if [[ "$status" == ok:* ]]; then
        echo "Projekt:  $(ocp_cluster_namespace "$cluster_file")"
    fi
    _prod_warning "$name"
}

# Zaloguj tylko, jeśli nie ma ważnej sesji użytkownika OCP_USER
ensure_login() {
    local name="$1"
    _require_cluster "$name" || return 1

    local cluster_file
    cluster_file=$(ocp_cluster_file "$name")
    local status
    status=$(ocp_session_status "$cluster_file")

    if ocp_session_is_mine "$status"; then
        echo -e "  Sesja: $(ocp_format_status "$status")"
    elif [[ "$status" == "unreachable" ]]; then
        echo -e "  Sesja: $(ocp_format_status "$status") ${GRAY}- sprawdź sieć/VPN${NC}"
    else
        if [[ "$status" == ok:* ]]; then
            echo -e "${YELLOW}Kubeconfig używa konta ${status#ok:} - loguję jako $OCP_USER${NC}"
        fi
        ocp_login_cluster "$name" || return 1
    fi

    _prod_warning "$name"
}

logout_clusters() {
    local names=("$@")

    if [[ ${#names[@]} -eq 0 ]]; then
        echo -e "${RED}Podaj klaster lub --all${NC}"
        return 1
    fi
    if [[ "${names[0]}" == "--all" ]]; then
        names=($(ocp_cluster_names))
    fi

    echo -e "${BLUE}Wylogowanie:${NC}"
    local name rc=0
    for name in "${names[@]}"; do
        _require_cluster "$name" || { rc=1; continue; }
        ocp_logout_cluster "$name"
    done
    return $rc
}

# ============================================
# GŁÓWNA CZĘŚĆ
# ============================================

if ! command -v oc &> /dev/null; then
    echo -e "${RED}Brak polecenia 'oc' w PATH${NC}"
    exit 1
fi

mkdir -p "$KUBE_CLUSTERS_DIR"
chmod 700 "$KUBE_CLUSTERS_DIR"
_protect_default_kubeconfig

case "${1:-}" in
    -h|--help|"")  show_help ;;
    --set-user)    set_user "$2" ;;
    --set-ca)      set_ca "$2" ;;
    --config)      show_config ;;
    --add)         add_cluster "$2" "$3" ;;
    -l|--list)     list_clusters ;;
    -s|--status)   show_status "$2" ;;
    --ensure)      ensure_login "$2" ;;
    --logout)      shift; logout_clusters "$@" ;;
    -*)
        echo -e "${RED}Nieznana opcja: $1${NC}"
        show_help
        exit 1
        ;;
    *)
        _require_cluster "$1" && ocp_login_cluster "$1" && _prod_warning "$1"
        ;;
esac
