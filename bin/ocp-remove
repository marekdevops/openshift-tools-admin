#!/bin/bash
#
# ocp-remove - Usuwanie klastrów z listy (archiwizacja lub trwałe usunięcie)
#
# Użycie: ocp-remove [OPCJE] klaster [klaster...]
#
# Domyślnie kubeconfig klastra jest przenoszony do ~/.kube/clusters/.archive/
# i można go przywrócić przez --restore.
#

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/ocp-common.sh" || exit 1

ARCHIVE_DIR="$KUBE_CLUSTERS_DIR/.archive"
BACKUP_DIR="$HOME/.kube/backup-$(date +%Y%m%d-%H%M%S)"

show_help() {
    echo "ocp-remove - Usuwanie klastrów z listy"
    echo ""
    echo "Użycie: ocp-remove [OPCJE] klaster [klaster...]"
    echo ""
    echo "Opcje:"
    echo "  (brak)          Zarchiwizuj klaster (znika z listy, można przywrócić)"
    echo "  -r, --restore   Przywróć zarchiwizowany klaster"
    echo "  -d, --delete    Wyloguj i usuń klaster trwale (z backupem w ~/.kube/backup-*)"
    echo "  -l, --list      Pokaż zarchiwizowane klastry"
    echo "  -y, --yes       Nie pytaj o potwierdzenie"
    echo "  -h, --help      Pokaż tę pomoc"
    echo ""
    echo "Przykłady:"
    echo "  ocp-remove stary-klaster            # archiwizacja"
    echo "  ocp-remove test1 test2              # kilka klastrów naraz"
    echo "  ocp-remove --restore stary-klaster  # przywrócenie"
    echo "  ocp-remove --delete stary-klaster   # trwałe usunięcie"
}

_confirm() {
    [[ $ASSUME_YES -eq 1 ]] && return 0
    read -p "$1 (t/n): " answer
    [[ "$answer" == "t" ]]
}

_warn_if_active() {
    if [[ "$KUBECONFIG" == "$(ocp_cluster_file "$1")" ]]; then
        echo -e "  ${YELLOW}UWAGA: to aktualny klaster (KUBECONFIG) - przełącz się na inny${NC}"
    fi
}

archive_cluster() {
    local name="$1"
    local cluster_file
    cluster_file=$(ocp_cluster_file "$name")

    if [[ ! -f "$cluster_file" ]]; then
        echo -e "${RED}Klaster '$name' nie istnieje w $KUBE_CLUSTERS_DIR${NC}"
        return 1
    fi

    if [[ -e "$ARCHIVE_DIR/$name" ]]; then
        echo -e "${RED}Klaster '$name' jest już w archiwum - usuń go najpierw: ocp-remove --delete $name${NC}"
        return 1
    fi

    mkdir -p "$ARCHIVE_DIR"
    chmod 700 "$ARCHIVE_DIR"

    mv "$cluster_file" "$ARCHIVE_DIR/$name" || return 1
    echo -e "${GREEN}Zarchiwizowano: $name${NC}"
    _warn_if_active "$name"
}

restore_cluster() {
    local name="$1"
    local cluster_file
    cluster_file=$(ocp_cluster_file "$name")

    if [[ ! -f "$ARCHIVE_DIR/$name" ]]; then
        echo -e "${RED}Klaster '$name' nie istnieje w archiwum${NC}"
        return 1
    fi

    if [[ -e "$cluster_file" ]]; then
        echo -e "${RED}Klaster '$name' już istnieje w $KUBE_CLUSTERS_DIR - nie nadpisuję${NC}"
        return 1
    fi

    mv "$ARCHIVE_DIR/$name" "$cluster_file" || return 1
    echo -e "${GREEN}Przywrócono: $name${NC}"
}

delete_cluster() {
    local name="$1"
    local found=()

    [[ -f "$(ocp_cluster_file "$name")" ]] && found+=("$(ocp_cluster_file "$name")")
    [[ -f "$ARCHIVE_DIR/$name" ]] && found+=("$ARCHIVE_DIR/$name")

    if [[ ${#found[@]} -eq 0 ]]; then
        echo -e "${RED}Klaster '$name' nie istnieje (ani w archiwum)${NC}"
        return 1
    fi

    echo -e "${YELLOW}Trwałe usunięcie klastra '$name':${NC}"
    printf '  %s\n' "${found[@]}"

    if ! _confirm "Usunąć?"; then
        echo "Pominięto: $name"
        return 1
    fi

    # Backup przed usunięciem, potem unieważnienie sesji na klastrze -
    # samo skasowanie pliku zostawiłoby ważny token na serwerze
    mkdir -p "$BACKUP_DIR/$name"
    chmod 700 "$BACKUP_DIR"
    local f
    for f in "${found[@]}"; do
        if [[ "$f" == "$ARCHIVE_DIR/"* ]]; then
            cp -a "$f" "$BACKUP_DIR/$name/archive"
        else
            cp -a "$f" "$BACKUP_DIR/$name/active"
        fi
        if grep -q '^ *token: *[^ ]' "$f"; then
            oc logout --kubeconfig="$f" --request-timeout="${OCP_TIMEOUT}s" &>/dev/null
        fi
    done
    sed -i '/^ *token: /d' "$BACKUP_DIR/$name"/*

    rm -f "${found[@]}"

    echo -e "${GREEN}Usunięto: $name${NC} (backup bez tokenów: $BACKUP_DIR/$name)"
    _warn_if_active "$name"
}

list_archived() {
    echo -e "${BLUE}Zarchiwizowane klastry:${NC}"

    local count=0
    local cluster
    for cluster in "$ARCHIVE_DIR"/*; do
        [[ -f "$cluster" ]] || continue
        echo "  $(basename "$cluster")  $(ocp_cluster_server "$cluster")"
        ((count++))
    done

    if [[ $count -eq 0 ]]; then
        echo "  (brak)"
    else
        echo ""
        echo "Przywróć: ocp-remove --restore [nazwa]"
    fi
}

# Parsowanie argumentów
ACTION="archive"
ASSUME_YES=0
CLUSTERS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--restore) ACTION="restore"; shift ;;
        -d|--delete)  ACTION="delete"; shift ;;
        -l|--list)    ACTION="list"; shift ;;
        -y|--yes)     ASSUME_YES=1; shift ;;
        -h|--help)    show_help; exit 0 ;;
        -*)
            echo -e "${RED}Nieznana opcja: $1${NC}"
            show_help
            exit 1
            ;;
        *)            CLUSTERS+=("$1"); shift ;;
    esac
done

if [[ "$ACTION" == "list" ]]; then
    list_archived
    exit 0
fi

if [[ ${#CLUSTERS[@]} -eq 0 ]]; then
    show_help
    exit 1
fi

rc=0
for name in "${CLUSTERS[@]}"; do
    if ! ocp_valid_name "$name"; then
        echo -e "${RED}Nieprawidłowa nazwa klastra: '$name'${NC}"
        rc=1
        continue
    fi

    case "$ACTION" in
        archive) archive_cluster "$name" || rc=1 ;;
        restore) restore_cluster "$name" || rc=1 ;;
        delete)  delete_cluster "$name" || rc=1 ;;
    esac
done

exit $rc
