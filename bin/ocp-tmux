#!/bin/bash
#
# ocp-tmux - Tworzenie sesji tmux z oknami dla klastrów OpenShift
#
# Użycie:
#   ocp-tmux                      # sesja z oknami dla wszystkich klastrów
#   ocp-tmux prod-cluster1 dev    # sesja tylko z wybranymi klastrami
#   ocp-tmux -a                   # dołącz do istniejącej sesji
#
# Przed utworzeniem okien loguje (w tym terminalu) do klastrów z wygasłą
# sesją, żeby okna nie pytały o hasło jednocześnie.
#

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/ocp-common.sh" || exit 1

SESSION_NAME="ocp"
ACTIVATE="$OCP_TOOLS_DIR/bin/ocp-activate"
[[ -f "$ACTIVATE" ]] || ACTIVATE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ocp-activate"

show_help() {
    echo "Tworzenie sesji tmux z oknami dla klastrów OpenShift"
    echo ""
    echo "Użycie:"
    echo "  ocp-tmux                        # wszystkie klastry"
    echo "  ocp-tmux prod-cluster1 dev      # wybrane klastry"
    echo "  ocp-tmux -a                     # dołącz do sesji"
    echo "  ocp-tmux -k                     # zamknij sesję"
    echo "  ocp-tmux -l                     # lista klastrów"
    echo ""
    echo "W sesji tmux:"
    echo "  Ctrl+b n     - następne okno"
    echo "  Ctrl+b p     - poprzednie okno"
    echo "  Ctrl+b w     - lista okien"
    echo "  Ctrl+b d     - odłącz (sesja działa w tle)"
}

if ! command -v tmux &> /dev/null; then
    echo -e "${RED}Błąd: tmux nie jest zainstalowany${NC}"
    echo "Zainstaluj: sudo dnf install tmux"
    exit 1
fi

case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    -a|--attach)
        if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
            exec tmux attach -t "=$SESSION_NAME"
        fi
        echo -e "${YELLOW}Sesja '$SESSION_NAME' nie istnieje. Tworzę nową...${NC}"
        shift
        ;;
    -k|--kill)
        if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
            tmux kill-session -t "=$SESSION_NAME"
            echo -e "${GREEN}Sesja '$SESSION_NAME' zamknięta${NC}"
        else
            echo "Sesja '$SESSION_NAME' nie istnieje"
        fi
        exit 0
        ;;
    -l|--list)
        exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ocp-login" --list
        ;;
esac

if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
    echo -e "${YELLOW}Sesja '$SESSION_NAME' już istnieje. Dołączam...${NC}"
    exec tmux attach -t "=$SESSION_NAME"
fi

if [[ $# -gt 0 ]]; then
    REQUESTED=("$@")
else
    REQUESTED=($(ocp_cluster_names))
fi

CLUSTERS=()
for cluster in "${REQUESTED[@]}"; do
    if ocp_valid_name "$cluster" && [[ -f "$(ocp_cluster_file "$cluster")" ]]; then
        CLUSTERS+=("$cluster")
    else
        echo -e "${YELLOW}Pomijam '$cluster' - nie istnieje${NC}"
    fi
done

if [[ ${#CLUSTERS[@]} -eq 0 ]]; then
    echo -e "${RED}Brak klastrów w $KUBE_CLUSTERS_DIR${NC}"
    echo "Dodaj: ocp-login --add klaster https://api.xxx:6443"
    exit 1
fi

# Logowanie przed utworzeniem okien
echo -e "${BLUE}Sprawdzanie sesji...${NC}"
for cluster in "${CLUSTERS[@]}"; do
    echo -e "${CYAN}$cluster${NC}"
    "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ocp-login" --ensure "$cluster"
done
echo ""

# Okna adresowane przez window_id - nazwy klastrów mogą zawierać '.'
first=1
for cluster in "${CLUSTERS[@]}"; do
    if [[ $first -eq 1 ]]; then
        window=$(tmux new-session -d -s "$SESSION_NAME" -n "$cluster" -P -F '#{window_id}')
        first=0
    else
        window=$(tmux new-window -d -t "=$SESSION_NAME:" -n "$cluster" -P -F '#{window_id}')
    fi
    tmux set-option -w -t "$window" @ocp_cluster "$cluster"
    tmux send-keys -t "$window" "source '$ACTIVATE' -q '$cluster'" Enter
done

tmux select-window -t "=$SESSION_NAME:^"
exec tmux attach -t "=$SESSION_NAME"
