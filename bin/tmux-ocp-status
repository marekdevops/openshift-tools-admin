#!/bin/bash
#
# tmux-ocp-status - Kolorowy status klastra dla tmux statusline
#
# Użycie w tmux.conf (nazwa klastra z opcji okna ustawianej przez 'ocp'):
#   #(~/.local/share/openshift-tools/bin/tmux-ocp-status '#{@ocp_cluster}')
#

CLUSTER="$1"

if [[ -z "$CLUSTER" ]]; then
    echo "#[fg=colour244]☸ ---"
    exit 0
fi

# Koloruj według typu środowiska
case "$CLUSTER" in
    *prod*)
        # Czerwony dla produkcji
        echo "#[fg=colour196,bold]☸ $CLUSTER"
        ;;
    *stag*)
        # Żółty dla staging
        echo "#[fg=colour214]☸ $CLUSTER"
        ;;
    *dev*)
        # Zielony dla dev
        echo "#[fg=colour82]☸ $CLUSTER"
        ;;
    *test*)
        # Niebieski dla test
        echo "#[fg=colour39]☸ $CLUSTER"
        ;;
    *)
        # Domyślny kolor
        echo "#[fg=colour255]☸ $CLUSTER"
        ;;
esac
